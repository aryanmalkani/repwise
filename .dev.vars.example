# Local settings for "npm run dev". Copy this file to .dev.vars and fill it in.
# .dev.vars stays on your laptop: it's listed in .gitignore, so it never goes to GitHub.

APP_PASSWORD=change-me
SESSION_SECRET=type-any-long-random-text-here-at-least-32-characters
# Optional: your key from https://platform.openai.com/api-keys to test AI reviews locally
OPENAI_API_KEY=
